# Market Observatory configuration
# Copy to .env and fill values.

# ClickHouse connection
CH_HOST=110.172.21.62
CH_PORT=8123
CH_USERNAME=default
CH_PASSWORD="Maxspike#2609"
CH_DATABASE=tick_data_db
CH_TABLE=market_data

# ClickHouse live polling (latency vs load tradeoff)
# Smaller interval + smaller batches = lower latency, more requests.
CH_POLL_INTERVAL_MS=50
CH_BATCH_SIZE=500

# Optional: logging
LOG_LEVEL=INFO

# Kite (Zerodha) - used for live failover in later steps
# IMPORTANT: do not commit real secrets to git.

# API
KITE_API_KEY=za4r7gn8aqq3tnwb
KITE_API_SECRET=qsk7eeuhgnx4ppvhsixhh70joexn2hov
KITE_REDIRECT_URL=


# Automated login (required)
KITE_USER_ID=LEY228
KITE_PASSWORD=Dell@123
KITE_TOTP_SECRET=CLHLMHAJKIVDDRXA6BFXM3UNUOYAU7EK

# Optional emergency override (not the default path):
# If provided, later implementation may use it to skip login when explicitly configured.
KITE_ACCESS_TOKEN=

# Optional: used by automated Selenium login (required if you want the system to fetch access_token itself)
KITE_CHROMEDRIVER_PATH=C:\Users\LENOVO\Desktop\market-observatory\chromedriver-win64\chromedriver.exe

# Instrument master CSV folder (repo includes reference CSVs under docs/kite_inspiration/instrument master)
KITE_INSTRUMENT_MASTER_DIR=docs/kite_inspiration/instrument master

# Which exchanges to load from instrument master (comma-separated)
# Only NSE and NFO are stored in ClickHouse, so filter to those
KITE_INSTRUMENT_EXCHANGES=NSE,NFO

# Streaming behavior (later step)
KITE_WS_MODE=full

# Failover (ClickHouse -> Kite WS)
# If ClickHouse is silent for this long (per symbol), switch to Kite WS.
FAILOVER_PRIMARY_SILENCE_MS=500

# Feature engine (pure/deterministic) thresholds (required)
FEATURE_PRICE_EPS=0.0001
FEATURE_DEPTH_SLOPE_EPS=0.0001
FEATURE_SPREAD_FLOOR=0.0001
FEATURE_LIQUIDITY_SHOCK_THRESHOLD=0.6

# ─────────────────────────────────────────────────────────────────────────────
# Streaming Engine
# ─────────────────────────────────────────────────────────────────────────────
STREAM_GAP_THRESHOLD_MS=5000
STREAM_UI_EMIT_INTERVAL_MS=100

# ─────────────────────────────────────────────────────────────────────────────
# Execution Hint Engine
# ─────────────────────────────────────────────────────────────────────────────
EXEC_ROLLING_WINDOW=100
EXEC_MIN_HISTORY=20
EXEC_DEPTH_STRONG_PCT=0.6
EXEC_DEPTH_MIN_PCT=0.2
EXEC_OFI_SPIKE_STD_MULT=2.0
EXEC_SPREAD_TIGHT_TICKS=2.0
EXEC_SPREAD_MAX_TICKS=10.0
EXEC_IMBALANCE_NEUTRAL=0.1
EXEC_IMBALANCE_STRONG=0.4

# ─────────────────────────────────────────────────────────────────────────────
# Tradeability Scoring
# ─────────────────────────────────────────────────────────────────────────────
RISK_TRADE_WINDOW=50
RISK_TRADE_MIN_HISTORY=10
RISK_SPREAD_TARGET_TICKS=2.0
RISK_SPREAD_MAX_TICKS=10.0
RISK_SHOCK_RATE_BAD=0.3
RISK_RECOVERY_TICKS_BAD=20
RISK_RECOVERY_DEPTH_SLOPE_FLOOR=0.1
RISK_RECOVERY_SPREAD_TICKS=3.0
RISK_W_SPREAD=0.4
RISK_W_SHOCK=0.3
RISK_W_RECOVERY=0.3
RISK_MIN_TRADEABLE_SCORE=0.5

# ─────────────────────────────────────────────────────────────────────────────
# Kill Switch
# ─────────────────────────────────────────────────────────────────────────────
KILL_PARTIAL_IS_FATAL=true
KILL_REORDER_DROPS_TRIP_TOTAL=5
KILL_TRADEABILITY_TRIP_SCORE=0.3
KILL_CLEAR_CONFIRM_TICKS=10

# ─────────────────────────────────────────────────────────────────────────────
# Rolling Features
# ─────────────────────────────────────────────────────────────────────────────
ROLLING_WINDOW_TICKS=50
ROLLING_MIN_TICKS=10
ROLLING_ABSORPTION_VOL_PCT=0.8
ROLLING_ABSORPTION_PRICE_MAX=0.0005

# ─────────────────────────────────────────────────────────────────────────────
# Live Mode (clickhouse | clickhouse_failover_kite | kite_only)
# ─────────────────────────────────────────────────────────────────────────────
LIVE_MODE=kite_only
